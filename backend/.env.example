# Variáveis de ambiente do BACKEND
# Configure no Render: Environment › Environment Variables
# Para desenvolvimento local, copie este arquivo para .env e preencha os valores.

PORT=3000

# ── URLs públicas ─────────────────────────────────────────────────
# URL do frontend na Vercel (sem barra final) — usada no redirect pós-pagamento
# da LOJA e na lista de origens do CORS.
APP_URL=https://seu-app.vercel.app
# URL do próprio backend no Render (sem barra final) — usada no webhook_url
# enviado à InfinitePay e é a base do webhook cadastrado no Mercado Pago.
API_URL=https://seu-app.onrender.com

# ── LOJA — InfinitePay ────────────────────────────────────────────
# Slug/handle da conta InfinitePay (obrigatório para o checkout da loja).
# Só a loja usa esta variável; o churrasco não a lê.
INFINITEPAY_HANDLE=seu_handle_aqui

# ── CHURRASCO — Mercado Pago (Checkout Transparente, só Pix) ──────
# Access Token da aplicação no Mercado Pago. EXISTE SÓ NO BACKEND: nunca use
# prefixo VITE_ e nunca coloque no frontend.
#   TEST-...    credencial de teste (sandbox)
#   APP_USR-... credencial de produção
MERCADO_PAGO_ACCESS_TOKEN=
# Chave secreta da assinatura do webhook (Suas integrações › Webhooks).
# Sem ela o webhook recusa TODAS as notificações com 401.
MERCADO_PAGO_WEBHOOK_SECRET=
# Aba onde as inscrições do churrasco são gravadas.
CHURRASCO_SHEET_NAME=Inscrições Churrasco
# Opcional: segredo para derivar o token público de consulta da inscrição e a
# chave de idempotência. Vazio, é derivado do segredo do webhook (ou da chave
# privada da service account) — ambos existem só no backend.
CHURRASCO_TOKEN_SECRET=
# Segredo que assina o QR Code do comprovante em PDF. Pelo menos 32 bytes
# aleatórios; gere com:  openssl rand -hex 32
# Só no backend: nunca com prefixo VITE_, nunca no PDF, nunca em log.
# Trocá-lo invalida os QR Codes já impressos — a página de validação passa a
# recusá-los, então troque só se precisar mesmo.
COMPROVANTE_SIGNING_SECRET=

# A Public Key do Mercado Pago NÃO é necessária: o Pix é criado inteiramente
# pelo backend e a página só renderiza o QR Code que ele devolve.

# ── Google Sheets (loja e churrasco) ──────────────────────────────
# ID da planilha (parte da URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Nome da aba onde os pedidos da LOJA são registrados
GOOGLE_SHEETS_SHEET_NAME=Pedidos AASIAM
# E-mail da Service Account (compartilhe a planilha com este e-mail como Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sua-conta@seu-projeto.iam.gserviceaccount.com
# Chave privada PEM — mantenha as quebras de linha como \n literais (não reais)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
# Alternativa: chave em Base64 (evita problemas com \n em alguns painéis)
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
